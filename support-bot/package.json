{
  "name": "racktrack-support-bot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Standalone grounded support bot for RackTrack. Not wired into the app - run and evaluate independently.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "eval": "node eval/run.js",
    "eval:verbose": "node eval/run.js --verbose",
    "kb:stats": "node src/kb.js --stats"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
