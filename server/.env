# ══ EMAIL / SMTP — codes, password reset, report share ══════════════
# The app tries PRIMARY (SMTP_*) first; if that send errors it AUTOMATICALLY
# falls back to FALLBACK (SMTP_FALLBACK_*). So one provider hitting its limit
# or going down never blocks sign-in codes. Restart the server after editing
# this file (nodemon does NOT reload .env).
# ── PRIMARY (SMTP_*) — Gmail, currently active & working ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aasrithasravani016@gmail.com
SMTP_PASS=unfm hcuz sfsn njmf
SMTP_FROM=RackTrack <aasrithasravani016@gmail.com>

# ── FALLBACK (SMTP_FALLBACK_*) — optional 2nd provider ───────────────
# Enable this to add a safety net (tried only if PRIMARY fails).
