# ── RECOMMENDED SETUP once Brevo is activated ────────────────────────
# Make Brevo the PRIMARY and keep Gmail as the FALLBACK:
#   1. Activate the Brevo account + generate a FRESH SMTP key (the key below
#      returned 535 auth failed — likely the account was not yet activated).
#   2. Set the PRIMARY block above to the Brevo values:
#        SMTP_HOST=smtp-relay.brevo.com
#        SMTP_PORT=587
#        SMTP_USER=b149fa001@smtp-brevo.com     (or your current Brevo login)
#        SMTP_PASS=<fresh Brevo SMTP key>
#        SMTP_FROM=RackTrack <aasrithasravani016@gmail.com>   (verify this sender in Brevo)
#   3. Uncomment the FALLBACK block above (Gmail) so codes still go out if
#      Brevo ever errors. Then restart the server.

# ── Netdisco (local Docker on this PC) ─────────────────────────
NETDISCO_URL=http://localhost:5000
NETDISCO_USER=admin
NETDISCO_PASSWORD=admin

# ── Port-drift poller ──────────────────────────────────────────
# Bench TP-Link smart switch — host is intentionally only here, not
# baked into source or shown in the UI. The auto-seeder reads this on
# first startup; change requires re-seed (delete monitored_devices row).
TPLINK_BENCH_HOST=192.168.1.33
# Poll cadence in ms. 5s catches brief cable flaps; default would be 60s.
PORT_POLL_INTERVAL_MS=5000

# ── Python interpreter for the CV pipeline ──────────────────────
# The bare "py" launcher on this machine defaults to 3.14, whose torchvision
# is a CPU-only build mismatched with its CUDA torch (breaks torchvision::nms
# on the CUDA backend). 3.11 has matching torch/torchvision cu118 builds.
PYTHON_PATH=C:\Program Files\Python311\python.exe

# ── Scan concurrency ───────────────────────────────────────────
# Number of warm Python CV workers. Default is 1 (scans run one-at-a-time).
# Raised to 5 so a group of testers can scan in parallel without queueing.
# Each worker loads all models into RAM, so keep this well under the core
# count (this Mac has 15) and watch memory.
RACKTRACK_WORKERS=5


