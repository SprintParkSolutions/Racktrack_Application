# ── RackTrack server environment ──────────────────────────────────────
# Copy to `server/.env` and fill in real values. NEVER commit the real .env.
# In production, source these from a secrets manager rather than a file.

# Core
NODE_ENV=production            # MUST be "production" in prod (locks CORS + hides error details)
PORT=3001
CORS_ORIGINS=https://app.example.com   # comma-separated allowlist of allowed web origins

# Auth — the JWT signing secret is auto-generated to server/data/jwt.secret
# if unset. Set it explicitly in prod (and keep it OUT of git):
# JWT_SECRET=<64+ random hex chars>

# Outbound email (verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password          # Gmail app password — secret
SMTP_FROM=RackTrack <your-account@gmail.com>

# Netdisco (network inventory source of truth)
NETDISCO_URL=http://netdisco:5000
NETDISCO_USER=changeme
NETDISCO_PASSWORD=changeme           # secret

# Switch SSH credentials (encrypted at rest). The decryption key lives in
# server/.env.key — keep BOTH out of git, and store the key separately from
# this ciphertext in prod.
SSH_CREDS_ENC=

# Bench / demo switch
TPLINK_BENCH_HOST=192.168.1.14

# Port-drift polling
PORT_POLL_INTERVAL_MS=60000

# Python interpreter + CV worker pool
# PYTHON_PATH=python3
# RACKTRACK_WORKERS=2                 # set to fit host RAM (each worker holds all models)
