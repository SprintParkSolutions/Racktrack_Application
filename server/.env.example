# ── RackTrack server environment ──────────────────────────────────────
# Copy to `server/.env` and fill in real values. NEVER commit the real .env.
# In production, source these from a secrets manager rather than a file.

# Core
# MUST be exactly "production" in prod (locks CORS + hides error details).
# NOTE: the loader in app.js does NOT strip inline comments — it takes
# everything after "=" verbatim. Put comments on their own line or the
# value becomes "production   # MUST be..." which !== "production", and
# the server silently stays in dev mode leaking raw errors.
NODE_ENV=production
PORT=3001
# Comma-separated allowlist of allowed web origins.
# The variable is CORS_ALLOWED_ORIGINS — app.js:260 reads that name, not
# CORS_ORIGINS, which this file used to document. Setting the old name did
# nothing at all.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Auth — the JWT signing secret is auto-generated to server/data/jwt.secret
# if unset. Set it explicitly in prod (and keep it OUT of git):
# JWT_SECRET=<64+ random hex chars>

# Outbound email (verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
# Gmail app password — secret.
SMTP_PASS=your-app-password
SMTP_FROM=RackTrack <your-account@gmail.com>

# Netdisco (network inventory source of truth)
NETDISCO_URL=http://netdisco:5000
NETDISCO_USER=changeme
# secret
NETDISCO_PASSWORD=changeme

# Switch SSH credentials (encrypted at rest). The decryption key lives in
# server/.env.key — keep BOTH out of git, and store the key separately from
# this ciphertext in prod.
SSH_CREDS_ENC=

# Bench / demo switch
TPLINK_BENCH_HOST=192.168.1.14

# Port-drift polling
PORT_POLL_INTERVAL_MS=60000

# Python interpreter + CV worker pool
# PYTHON_PATH=python3
# RACKTRACK_WORKERS=2                 # set to fit host RAM (each worker holds all models)

# ── Session cookies (web) ────────────────────────────────────
# Browsers hold a short-lived access JWT plus a rotating refresh token, both
# httpOnly so no script can read them. The native app is unaffected: it has no
# usable cookie jar for capacitor://localhost and still uses a Bearer token.
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
# Leave unset unless the API and the web app sit on different subdomains.
# COOKIE_DOMAIN=.racktrack.ai
# A `secure` cookie is silently DROPPED over plain http, which looks exactly
# like login succeeding and then not working. Unset means: on in production,
# off everywhere else. Only set this to false deliberately, for an http host.
# COOKIE_SECURE=true
# 'lax' is right while the API and web app share an origin (the demo setup).
# Serving them from different sites needs 'none', which also requires secure.
COOKIE_SAMESITE=lax
# How long after a refresh token rotates a duplicate presentation is still
# treated as two tabs racing rather than a stolen token.
REFRESH_REUSE_GRACE_MS=5000

# Set on a deployment hosted AWAY from the switches (a public cloud instance).
# The switch login still works and the attempt still runs — this only caps the
# SSH timeout so "no route" fails in seconds, and replaces the resulting
# "The switch didn't respond" with your own sentence, so nobody goes hunting for
# a fault on a switch that is fine. A rejected password still says so.
#
# Leave UNSET on any install on the same network as its switches.
# LIVE_SWITCH_OFF_NETWORK=1
# LIVE_SWITCH_NOTE=Your own short sentence, shown verbatim to the user.

# Seeded Netdisco inventory for the public demo ONLY. The Network view answers
# from server/lib/demo_data.js instead of a real Netdisco, because a cloud VPS
# has none near it. Never set this on a real deployment — presenting invented
# network data as measured is exactly the failure it must not cause. The server
# logs a loud warning at startup while it is on.
#
# It does NOT touch the Lab page or the Live Network Switch page: those always
# SSH into real hardware and show it unreachable when it is, in every mode.
# RACKTRACK_DEMO_DATA=1
