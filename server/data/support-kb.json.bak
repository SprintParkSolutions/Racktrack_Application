          "lines": "414-423",
          "snippet": "return jwt.sign(\n    { sub: user.id, username: user.username, tenantId: user.tenant_id,\n      organizationId: user.organization_id || null, role: user.role || 'member' },\n    JWT_SECRET,\n    { expiresIn: TOKEN_TTL }\n  );"
