        {
          "file": "client/src/utils/portsProbe.js",
          "lines": "139-142",
          "snippet": "const SERVER_TIMEOUT_MS = 30000;\n  const WATCHDOG_MS = 38000;\n  const controller = new AbortController();\n  const watchdog = setTimeout(() => controller.abort(), WATCHDOG_MS);"
