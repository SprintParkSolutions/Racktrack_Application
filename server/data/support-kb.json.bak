          "file": "server/app.js",
          "lines": "413-416",
          "snippet": "function _safeExt(originalName) {\n  const m = String(originalName || '').match(/\\.(jpe?g|jfif|png|gif|webp|tiff?|avif|bmp|heic|heif|mp4|mov|webm|m4v|avi)$/i);\n  return m ? '.' + m[1].toLowerCase() : '';"
