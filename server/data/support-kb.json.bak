          "snippet": "const NETDISCO_URL  = process.env.NETDISCO_URL      || 'http://localhost:5000';\nconst ND_USER       = process.env.NETDISCO_USER     || 'admin';\nconst ND_PASSWORD   = process.env.NETDISCO_PASSWORD || 'admin';\nconst TIMEOUT_MS    = 15000;"
