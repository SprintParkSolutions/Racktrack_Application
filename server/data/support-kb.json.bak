          "lines": "19-21",
          "snippet": "if (file.type.startsWith('image/')) return validateImage(file);\n  if (file.type.startsWith('video/')) return validateVideo(file);\n  return { ok: false, error: 'Unsupported file type. Upload an image or video.' };"
        },
