        {
          "file": "/Volumes/Racktrack/dark_mobile/server/app.js",
          "lines": "485-491",
          "snippet": "function computeRackId(filePath) {\n  const hash = crypto\n    .createHash('sha256')\n    .update(fs.readFileSync(filePath))\n    .digest('hex');\n  return `RK-${hash.slice(0, 8).toUpperCase()}`;\n}"
