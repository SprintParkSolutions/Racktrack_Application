# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Python virtualenv (regenerable; contains >100MB binaries GitHub rejects)
.venv/
venv/

# Model weights — distributed separately, not version-controlled
*.pt
*.pth
*.onnx
Models/

# Local test-account credentials (plaintext password — never commit)
TEST_ACCOUNT.md

# Build artifacts
client/dist/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Pipeline outputs (generated at runtime)
outputs/

# Uploads (runtime data)
server/uploads/*
!server/uploads/.gitkeep

# Environment
.env
.env.local
.env.*.local
.env.key

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Server runtime state (DB backups, last-host tracking)
server/data/backups/
server/data/last-hosts/

# Scratch test artifacts at repo root (one-shot captures, leading dot)
/.benchmark_*.png
/.full_pipeline_*.png
/.test_rack_*.jpg
/.test_response.json

# ONNX fp32 sources — re-derivable from .pt files; the int8 builds we ship
# live in client/public/models/. Skipped here to keep the repo lean.
Models/exported/

# cloudflared binary — 63 MB, install via system package manager
# (winget install Cloudflare.cloudflared).
/cloudflared.exe
Models.zip

# Runtime state — regenerated by start.ps1 each run
/current-url.txt

# Personal OAuth token caches — produced by Slack/Teams/Outlook senders.
# These should never be committed (they grant access as the person who logged in).
pipeline/*_outlook_cache.json
pipeline/*_teams_cache.json
pipeline/*_slack_cache.json

# Word lock files (created when a .docx is open in Microsoft Word).
~$*.docx

# Old documentation archives — superseded by docs/features/.
/docs.zip
/docs/use-cases.zip
/cloudflared

# ── Secrets & runtime state (untracked 2026 — never commit) ──────────
client/.env.production
**/demo_tenant*.json
server/feedback.jsonl
server/data/last-hosts/
servicenow/mock_scans/**/feedback.jsonl

# Tester invite links (one-time codes) — do not commit
TESTER_INVITES.md
RACKTRACK_INVITES.md
server/data/racktrack-invites.json
RACKTRACK_INVITES.txt

# Local demo & tester materials (scripts, packets, credentials) — not for version control
demo/
testers/
THE-TESTERS_INVITES.txt

# Outlook token cache in any location (leak guard)
*_outlook_cache.json

# Local secrets/credentials — never version control
.secrets/

# Atlassian API token — never commit
atl_api.md
atl_token.txt

# Confluence page backup (local safety copy)
.confluence_backup_*/
client/.firebase-app-id
server/.env
server/.env.key
acc.md
apple.txt
