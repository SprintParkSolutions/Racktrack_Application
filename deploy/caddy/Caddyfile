# TLS + reverse proxy for the demo deployment (demo.racktrack.ai).
#
# Caddy obtains and renews the Let's Encrypt certificate itself. That needs
# BOTH :80 and :443 reachable from the internet — :80 carries the ACME
# HTTP-01 challenge, it is not merely a redirect. A firewall that opens only
# :443 leaves the site permanently without a certificate.

demo.racktrack.ai {
	encode zstd gzip

	# The server accepts uploads up to 340 MB (app.js multer limit). Caddy
	# must not cap below that or an eight-photo stitch is rejected out here,
	# before the app can give its own error.
	request_body {
		max_size 350MB
	}

	# This box has no GPU, so a scan is seconds of CPU inference and a
	# tall-rack stitch is longer. No timeout is configured on purpose: Caddy
	# defaults to waiting indefinitely for an upstream response, which is what
	# a slow CPU scan needs. Do not add `transport http { read_timeout ... }`
	# here — those are not valid subdirectives, and Caddy refuses to start on
	# a bad Caddyfile, taking the whole site down rather than just the tweak.
	# NetBox, viewable under the demo domain (no separate hostname). Its pages
	# ask for scripts and styles at /netbox/static/, which the container serves
	# at /static/ — so that prefix is stripped on the way through.
	handle /netbox* {
		@static path /netbox/static/*
		uri @static strip_prefix /netbox
		reverse_proxy netbox:8080
	}

	# RackTrack Approvals: the drift ticketing and approval workflow. Its own
	# bundle in /srv/approvals (bind-mounted from ./approvals-dist), built with
	# base /approvals/, served as another page of this site. Same origin, so it
	# uses the same API and the same session as the application; no second
	# sign-in and no second domain, and the application stays uncluttered.
	redir /approvals /approvals/ 308
	handle_path /approvals/* {
		# handle_path strips the prefix, so a request for
		# /approvals/assets/x.js reads /srv/approvals/assets/x.js and a deep
		# path such as /approvals/drifts/12 falls back to the bundle's own
		# index.html. The bundle is built with base /approvals/, so the links
		# it writes come back through this same handler.
		root * /srv/approvals
		try_files {path} /index.html
		file_server
	}

	reverse_proxy racktrack:3001

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# The owner and manager portal. A static bundle in /srv/portal (bind-mounted
# from ./portal-dist), with the API and rack photos proxied to the same app
# container the demo uses, so the portal is same-origin with its own API and
# the session cookie behaves exactly as it does in the phone app.
portal.racktrack.ai {
	encode zstd gzip
	root * /srv/portal

	handle /api/* {
		reverse_proxy racktrack:3001
	}

	handle /outputs/* {
		reverse_proxy racktrack:3001
	}

	handle /uploads/* {
		reverse_proxy racktrack:3001
	}

	# try_files is what makes a reload on a deep path such as /overview or
	# /audit serve the app rather than a 404.
	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/portal-access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
