# /etc/wireguard/wg0.conf — DEMO VPS side (demo.racktrack.ai)
#
# Copy to /etc/wireguard/wg0.conf, fill in the two keys, then
#   sudo ufw allow 51820/udp comment 'racktrack lab wireguard'
#   sudo systemctl enable --now wg-quick@wg0
#
# No compose change is needed. wg-quick installs the AllowedIPs routes into the
# HOST routing table, and container egress already traverses the host, so
# racktrack-demo reaches 192.168.1.62 with no extra_hosts and no published port.

[Interface]
PrivateKey = <VPS_PRIVATE_KEY>
Address    = 10.99.0.1/24
ListenPort = 51820

[Peer]
# Contents of /etc/wireguard/publickey on the EVE-NG host.
PublicKey = <EVENG_PUBLIC_KEY>

# THE SECURITY BOUNDARY. AllowedIPs is not a hint — WireGuard will not route a
# packet to a peer whose AllowedIPs does not cover the destination, and will drop
# an inbound packet whose source is not covered. So this line is the whole
# statement of what the public VPS may reach inside the office:
#
#   .33 = TL-SG2428P (real TP-Link bench)   .60 = L2SW2   .61 = L2SW1
#   .62 = CoreSW                            .63 = Sw1
#
# Individual /32s. NOT 192.168.1.0/24 — a compromised public box must not be
# handed the office LAN. If a switch joins or leaves, edit this list explicitly.
#
# NOTE on .33: that is the real TP-Link bench switch, and it DHCP-flaps between
# .14 and .33. If it lands on .14 the tunnel will not carry it until you add
# 192.168.1.14/32 here (and to the MASQUERADE list on the office end). A static
# lease for it is the better fix.
AllowedIPs = 192.168.1.33/32, 192.168.1.60/32, 192.168.1.61/32, 192.168.1.62/32, 192.168.1.63/32, 10.99.0.2/32

# No Endpoint: the office end is behind NAT and initiates. The VPS learns its
# address from the handshake and re-learns it when the office IP changes.
